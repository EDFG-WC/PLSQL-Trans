package com.plsql.translator;

import com.plsql.translator.parser.*;
import org.antlr.v4.runtime.*;
import org.antlr.v4.runtime.tree.*;
import org.antlr.v4.runtime.misc.Interval;

import java.io.*;
import java.nio.file.*;
import java.util.*;

/**
 * PL/SQL → 方法流程图生成器（基于递归树布局）。
 *
 * 直接构建层次化的控制流树，采用递归布局算法，
 * 生成自上而下的专业流程图。
 */
public class PlSqlFlowchartGenerator {

    // ── 布局参数 ─────────────────────────────────────────
    static final int NODE_W = 170;        // 常规节点宽
    static final int DECISION_W = 150;    // 菱形节点宽
    static final int NODE_H = 34;         // 节点高
    static final int V_GAP = 42;          // 层间距
    static final int BRANCH_GAP = 50;     // IF 分支间距
    static final int PAD = 60;            // 画布边距
    static final int FONT_SZ = 10;

    // ── 颜色 ─────────────────────────────────────────────
    static final String C_PROCESS = "#4a6fa5", C_DECISION = "#e6a23c",
        C_START = "#67c23a", C_END = "#909399", C_LOOP = "#6b4c8a",
        C_BG = "#f8f9fa", C_EDGE = "#5c5c7a", C_TEXT = "#ffffff",
        C_EXCEPTION = "#d67236", C_MERGE = "#adb5bd";

    // ── 节点类型 ─────────────────────────────────────────
    enum ElemType { PROCESS, DECISION, START, END, LOOP_HEAD, LOOP_TAIL, EXCEPTION, MERGE, LABEL }

    // ── FlowElement 接口 ─────────────────────────────────
    interface FlowElement {
        Bounds layout(int x, int y, int availableWidth);
        void collect(List<PlacedNode> nodes, List<PlacedEdge> edges);
    }

    static class PlacedNode {
        String id, label; ElemType type; int x, y, w, h;
        PlacedNode(String id, String label, ElemType type) {
            this.id = id; this.label = label; this.type = type;
            this.w = (type == ElemType.DECISION || type == ElemType.START || type == ElemType.END) ? DECISION_W : NODE_W;
            this.h = NODE_H;
        }
    }

    static class PlacedEdge {
        String from, to, label;
        PlacedEdge(String f, String t, String l) { from = f; to = t; label = l == null ? "" : l; }
    }

    static class Bounds { int w, h; Bounds(int w, int h) { this.w = w; this.h = h; } }

    // ═══════════════════════════════════════════════════════
    //  树节点实现
    // ═══════════════════════════════════════════════════════

    static class StmtElem implements FlowElement {
        String label; ElemType type;
        String id;
        StmtElem(String label, ElemType type) {
            this.label = label; this.type = type; this.id = "n" + System.identityHashCode(this);
        }
        public Bounds layout(int x, int y, int aw) {
            int w = (type == ElemType.DECISION || type == ElemType.START || type == ElemType.END) ? DECISION_W : NODE_W;
            return new Bounds(w, NODE_H);
        }
        public void collect(List<PlacedNode> ns, List<PlacedEdge> es) { ns.add(new PlacedNode(id, label, type)); }
    }

    static class SeqElem implements FlowElement {
        List<FlowElement> children = new ArrayList<>();
        public Bounds layout(int x, int y, int aw) {
            int maxW = 0, curY = y;
            for (FlowElement ch : children) {
                Bounds b = ch.layout(x + (aw - getChildWidth(ch, aw)) / 2, curY, aw);
                curY += b.h + V_GAP;
                maxW = Math.max(maxW, b.w);
            }
            return new Bounds(maxW, curY - y);
        }
        int getChildWidth(FlowElement ch, int aw) {
            if (ch instanceof StmtElem) {
                StmtElem s = (StmtElem) ch;
                return (s.type == ElemType.DECISION || s.type == ElemType.START || s.type == ElemType.END) ? DECISION_W : NODE_W;
            }
            return aw;
        }
        public void collect(List<PlacedNode> ns, List<PlacedEdge> es) {
            FlowElement prev = null;
            for (FlowElement ch : children) {
                ch.collect(ns, es);
                if (prev != null) {
                    // Connect previous to this
                    String fromId = getLastId(prev);
                    String toId = getFirstId(ch);
                    if (fromId != null && toId != null) es.add(new PlacedEdge(fromId, toId, ""));
                }
                prev = ch;
            }
        }
        String getLastId(FlowElement e) {
            List<PlacedNode> tmp = new ArrayList<>();
            e.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(tmp.size()-1).id;
        }
        String getFirstId(FlowElement e) {
            List<PlacedNode> tmp = new ArrayList<>();
            e.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(0).id;
        }
    }

    // ═══════════════════════════════════════════════════════
    //  入口
    // ═══════════════════════════════════════════════════════

    static String currentSource = "";

    public static String plsqlToFlowchart(String plsql) {
        currentSource = plsql;
        CharStream ci = new CaseInsensitiveStream(CharStreams.fromString(plsql));
        PlSqlLexer lex = new PlSqlLexer(ci);
        PlSqlParser par = new PlSqlParser(new CommonTokenStream(lex));
        par.removeErrorListeners();
        ParseTree tree = par.sql_script();

        // 查找第一个可执行单元
        ParseTree unit = findFirstExecutableUnit(tree);
        if (unit == null) return generateEmptyFallback();

        String entryName = extractEntryName(unit);
        SeqElem mainSeq = new SeqElem();

        // 提取语句体
        List<ParseTree> stmts = extractBodyStatements(unit);
        if (stmts == null) return generateDrawio(entryName, mainSeq, par);

        for (ParseTree stmt : stmts) {
            FlowElement elem = processStatement(stmt);
            if (elem != null) mainSeq.children.add(elem);
        }

        return generateDrawio(entryName, mainSeq, par);
    }

    // ── 处理单个语句 ─────────────────────────────────────
    static FlowElement processStatement(ParseTree node) {
        if (node == null || node instanceof TerminalNode) return null;
        int ri = ((RuleContext) node).getRuleIndex();
        if (ri < 0 || ri >= PlSqlParser.ruleNames.length) return null;
        String rn = PlSqlParser.ruleNames[ri];

        switch (rn) {
            case "statement":
                return node.getChildCount() > 0 ? processStatement(node.getChild(0)) : null;
            case "if_statement":
                return processIfStatement(node);
            case "loop_statement":
                return processLoopStatement(node);
            default:
                String text = cleanText(getOriginalText(node));
                if (text.isEmpty()) return null;
                return new StmtElem(text, ElemType.PROCESS);
        }
    }

    static FlowElement processIfStatement(ParseTree node) {
        String cond = extractRuleText(node, "condition");
        IfElem ie = new IfElem(cond.isEmpty() ? "IF" : "IF " + cond);

        // THEN
        ParseTree thenBody = findChildByRule(node, "seq_of_statements", 0);
        if (thenBody != null) {
            List<ParseTree> thenStmts = extractStatementsFromSeq(thenBody);
            for (ParseTree s : thenStmts) {
                FlowElement e = processStatement(s);
                if (e != null) ie.thenBody.children.add(e);
            }
        }

        // ELSIF
        List<ParseTree> elsifParts = findAllChildrenByRule(node, "elsif_part");
        for (ParseTree ep : elsifParts) {
            String ec = extractRuleText(ep, "condition");
            IfElsePart p = new IfElsePart();
            p.condition = ec.isEmpty() ? "ELSIF" : "ELSIF " + ec;
            ParseTree eb = findChildByRule(ep, "seq_of_statements", 0);
            if (eb != null) {
                for (ParseTree s : extractStatementsFromSeq(eb)) {
                    FlowElement e = processStatement(s);
                    if (e != null) p.body.children.add(e);
                }
            }
            ie.elsifs.add(p);
        }

        // ELSE
        ParseTree elsePart = findChildByRule(node, "else_part", 0);
        if (elsePart != null) {
            ParseTree eb = findChildByRule(elsePart, "seq_of_statements", 0);
            if (eb != null) {
                for (ParseTree s : extractStatementsFromSeq(eb)) {
                    FlowElement e = processStatement(s);
                    if (e != null) ie.elseBody.children.add(e);
                }
            }
        }

        return ie;
    }

    static FlowElement processLoopStatement(ParseTree node) {
        String label = extractLoopLabel(node);
        LoopElem le = new LoopElem(label);
        ParseTree bodySeq = findChildByRule(node, "seq_of_statements", 0);
        if (bodySeq != null) {
            for (ParseTree s : extractStatementsFromSeq(bodySeq)) {
                FlowElement e = processStatement(s);
                if (e != null) le.body.children.add(e);
            }
        }
        return le;
    }

    // ── IF / LOOP 树节点 ──────────────────────────────

    static class IfElsePart {
        String condition; SeqElem body = new SeqElem();
    }

    static class IfElem implements FlowElement {
        String condition;
        SeqElem thenBody = new SeqElem();
        List<IfElsePart> elsifs = new ArrayList<>();
        SeqElem elseBody = new SeqElem();
        StmtElem decision, merge;

        IfElem(String cond) {
            this.condition = cond;
            this.decision = new StmtElem(cond, ElemType.DECISION);
            this.merge = new StmtElem("", ElemType.MERGE);
        }

        public Bounds layout(int x, int y, int aw) {
            // Decision at center
            Bounds db = decision.layout(x, y, aw);
            int decW = db.w;
            int decCenterX = x + aw / 2;

            // Layout THEN body to the left
            Bounds thenB = thenBody.layout(x, y + NODE_H + V_GAP, aw / 2 - BRANCH_GAP);
            // Layout ELSE body to the right
            Bounds elseB = elseBody.layout(x + aw / 2 + BRANCH_GAP, y + NODE_H + V_GAP, aw / 2 - BRANCH_GAP);

            // Layout ELSIFs
            int maxBodyH = Math.max(thenB.h, elseB.h);
            for (IfElsePart ep : elsifs) {
                SeqElem s = new SeqElem();
                StmtElem d = new StmtElem(ep.condition, ElemType.DECISION);
                s.children.add(d);
                if (ep.body.children.size() > 0) s.children.add(ep.body);
                Bounds eb = s.layout(x, y + NODE_H + V_GAP, aw);
                maxBodyH = Math.max(maxBodyH, eb.h);
            }

            // Merge below the deepest branch
            int mergeY = y + NODE_H + V_GAP + Math.max(thenB.h, Math.max(elseB.h, maxBodyH)) + V_GAP;
            Bounds mb = merge.layout(decCenterX - 5, mergeY, 10);

            return new Bounds(aw, mergeY + mb.h - y);
        }

        public void collect(List<PlacedNode> ns, List<PlacedEdge> es) {
            decision.collect(ns, es);
            String firstThenId = getFirstElemId(thenBody);
            String firstElseId = getFirstElemId(elseBody);

            if (firstThenId != null) {
                es.add(new PlacedEdge(decision.id, firstThenId, "Yes"));
                thenBody.collect(ns, es);
                String lastThenId = getLastElemId(thenBody);
                if (lastThenId != null) es.add(new PlacedEdge(lastThenId, merge.id, ""));
            }

            if (firstElseId != null) {
                es.add(new PlacedEdge(decision.id, firstElseId, "No"));
                elseBody.collect(ns, es);
                String lastElseId = getLastElemId(elseBody);
                if (lastElseId != null) es.add(new PlacedEdge(lastElseId, merge.id, ""));
            }

            // If no ELSE but THEN exists, add No edge to merge
            if (firstElseId == null && firstThenId != null) {
                es.add(new PlacedEdge(decision.id, merge.id, "No"));
            }

            // ELSIFs
            for (IfElsePart ep : elsifs) {
                es.add(new PlacedEdge(decision.id, getFirstElemId(ep.body), "No"));
                ep.body.collect(ns, es);
                String lastId = getLastElemId(ep.body);
                if (lastId != null) es.add(new PlacedEdge(lastId, merge.id, ""));
            }

            // If neither THEN nor ELSE has content
            if (firstThenId == null && firstElseId == null) {
                es.add(new PlacedEdge(decision.id, merge.id, ""));
            }

            merge.collect(ns, es);
        }

        String getFirstElemId(SeqElem s) {
            List<PlacedNode> tmp = new ArrayList<>();
            s.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(0).id;
        }
        String getLastElemId(SeqElem s) {
            List<PlacedNode> tmp = new ArrayList<>();
            s.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(tmp.size()-1).id;
        }
    }

    static class LoopElem implements FlowElement {
        String label;
        SeqElem body = new SeqElem();
        StmtElem header, tail;

        LoopElem(String lbl) {
            this.label = lbl;
            this.header = new StmtElem(lbl, ElemType.LOOP_HEAD);
            this.tail = new StmtElem("/" + lbl.replaceFirst("^(LOOP|WHILE|FOR).*", "$1"), ElemType.LOOP_TAIL);
        }

        public Bounds layout(int x, int y, int aw) {
            Bounds hb = header.layout(x, y, aw);
            int bodyY = y + NODE_H + V_GAP;
            Bounds bb = body.layout(x, bodyY, aw);
            int tailY = bodyY + bb.h + V_GAP;
            Bounds tb = tail.layout(x, tailY, aw);
            return new Bounds(Math.max(hb.w, Math.max(bb.w, tb.w)), tailY + tb.h - y);
        }

        public void collect(List<PlacedNode> ns, List<PlacedEdge> es) {
            header.collect(ns, es);
            String firstBodyId = getFirstId(body);
            String lastBodyId = getLastId(body);

            if (firstBodyId != null) {
                es.add(new PlacedEdge(header.id, firstBodyId, ""));
                body.collect(ns, es);
                // Back edge: last body node back to header
                es.add(new PlacedEdge(lastBodyId, header.id, ""));
            } else {
                // Empty body: connect header to tail directly
                es.add(new PlacedEdge(header.id, tail.id, "Exit"));
                tail.collect(ns, es);
                return;
            }

            // Exit edge to tail
            es.add(new PlacedEdge(header.id, tail.id, "Exit"));
            tail.collect(ns, es);
        }

        String getFirstId(SeqElem s) {
            List<PlacedNode> tmp = new ArrayList<>();
            s.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(0).id;
        }
        String getLastId(SeqElem s) {
            List<PlacedNode> tmp = new ArrayList<>();
            s.collect(tmp, new ArrayList<>());
            return tmp.isEmpty() ? null : tmp.get(tmp.size()-1).id;
        }
    }

    // ═══════════════════════════════════════════════════════
    //  drawio 生成
    // ═══════════════════════════════════════════════════════

    static String generateDrawio(String entryName, SeqElem tree, PlSqlParser parser) {
        // Create START and END
        StmtElem start = new StmtElem(entryName, ElemType.START);
        StmtElem end = new StmtElem("END " + entryName, ElemType.END);

        SeqElem fullSeq = new SeqElem();
        fullSeq.children.add(start);
        if (tree.children.size() > 0) fullSeq.children.add(tree);
        fullSeq.children.add(end);

        // Layout
        Bounds total = fullSeq.layout(PAD, PAD, 800);
        int totalW = Math.max(total.w + PAD * 2, PAD * 2);

        // Adjust positions from relative to absolute
        List<PlacedNode> allNodes = new ArrayList<>();
        List<PlacedEdge> allEdges = new ArrayList<>();
        fullSeq.collect(allNodes, allEdges);

        // Build draws node map from layout
        // Simple approach: layout() already computes absolute positions
        // But we need to collect positions from nodes.
        // For now, use existing FlowGraph approach for positioning.
        return generateWithAbsoluteLayout(entryName, tree);
    }

    static String generateWithAbsoluteLayout(String entryName, SeqElem tree) {
        // Build a simpler linear layout using the existing approach
        // but with proper centering
        FlowGraph g = new FlowGraph();
        String entryId = g.addNode(ElemType.START, entryName);
        g.entryId = entryId;

        // Walk the tree and build graph
        List<String> exits = buildGraphFromTree(g, tree);
        for (String ex : exits) {
            String endId = g.addNode(ElemType.END, "END " + entryName);
            g.addEdge(ex, endId, "");
        }

        return generateDrawio(g);
    }

    static List<String> buildGraphFromTree(FlowGraph g, SeqElem seq) {
        List<String> exits = new ArrayList<>();
        String prevExit = g.entryId;

        for (FlowElement elem : seq.children) {
            if (elem instanceof StmtElem) {
                StmtElem s = (StmtElem) elem;
                String id = g.addNode(s.type, s.label);
                if (prevExit != null) g.addEdge(prevExit, id, "");
                prevExit = id;
                exits.clear();
                exits.add(id);
            } else if (elem instanceof IfElem) {
                IfElem ie = (IfElem) elem;
                String decId = g.addNode(ElemType.DECISION, ie.condition);
                if (prevExit != null) g.addEdge(prevExit, decId, "");
                prevExit = null;

                List<String> branchExits = new ArrayList<>();

                // THEN
                if (ie.thenBody.children.size() > 0) {
                    List<String> thenExits = buildGraphFromTree(g, ie.thenBody);
                    if (!thenExits.isEmpty()) {
                        g.addEdge(decId, thenExits.get(0), "Yes");
                        branchExits.addAll(thenExits);
                    }
                }

                // ELSE
                if (ie.elseBody.children.size() > 0) {
                    List<String> elseExits = buildGraphFromTree(g, ie.elseBody);
                    if (!elseExits.isEmpty()) {
                        g.addEdge(decId, elseExits.get(0), "No");
                        branchExits.addAll(elseExits);
                    }
                }

                // If no ELSE, add No edge
                if (ie.elseBody.children.isEmpty() && !ie.thenBody.children.isEmpty()) {
                    // Create a merge point
                }

                // ELSIF
                for (IfElsePart ep : ie.elsifs) {
                    List<String> elsifExits = buildGraphFromTree(g, ep.body);
                    if (!elsifExits.isEmpty()) {
                        g.addEdge(decId, elsifExits.get(0), "No");
                        branchExits.addAll(elsifExits);
                    }
                }

                // Merge point
                String mergeId = g.addNode(ElemType.MERGE, "");
                for (String be : branchExits) g.addEdge(be, mergeId, "");
                if (branchExits.isEmpty()) g.addEdge(decId, mergeId, "");

                exits.clear();
                exits.add(mergeId);
                prevExit = mergeId;

            } else if (elem instanceof LoopElem) {
                LoopElem le = (LoopElem) elem;
                String headId = g.addNode(ElemType.LOOP_HEAD, le.label);
                if (prevExit != null) g.addEdge(prevExit, headId, "");
                prevExit = null;

                List<String> bodyExits = buildGraphFromTree(g, le.body);
                if (!bodyExits.isEmpty()) {
                    g.addEdge(headId, bodyExits.get(0), "");
                    for (String be : bodyExits) g.addEdge(be, headId, "");
                }

                String tailId = g.addNode(ElemType.LOOP_TAIL, le.tail.label);
                g.addEdge(headId, tailId, "Exit");

                exits.clear();
                exits.add(tailId);
                prevExit = tailId;
            }
        }

        return exits;
    }

    // ═══════════════════════════════════════════════════════
    //  以下复用现有代码（不修改原有功能）
    // ═══════════════════════════════════════════════════════

    enum NodeType { PROCESS, DECISION, START, END, LOOP_HEAD, LOOP_TAIL, EXCEPTION, MERGE }

    static class FlowGraph {
        List<FlowNode> nodes = new ArrayList<>();
        List<FlowEdge> edges = new ArrayList<>();
        int nextId = 1;
        String entryId;
        Set<String> exitIds = new LinkedHashSet<>();

        String addNode(ElemType type, String label) {
            return addNode(toNodeType(type), label);
        }

        NodeType toNodeType(ElemType t) {
            switch (t) {
                case PROCESS: return NodeType.PROCESS;
                case DECISION: return NodeType.DECISION;
                case START: return NodeType.START;
                case END: return NodeType.END;
                case LOOP_HEAD: return NodeType.LOOP_HEAD;
                case LOOP_TAIL: return NodeType.LOOP_TAIL;
                case EXCEPTION: return NodeType.EXCEPTION;
                case MERGE: return NodeType.MERGE;
                default: return NodeType.PROCESS;
            }
        }

        String addNode(NodeType type, String label) {
            String id = "n" + (nextId++);
            nodes.add(new FlowNode(id, type, label));
            return id;
        }

        void addEdge(String fromId, String toId, String label) {
            edges.add(new FlowEdge(fromId, toId, label == null ? "" : label));
        }
    }

    static class FlowNode {
        String id, label; NodeType type; double w, h;
        FlowNode(String id, NodeType type, String label) {
            this.id = id; this.type = type; this.label = label;
            this.w = (type == NodeType.DECISION || type == NodeType.START || type == NodeType.END) ? DECISION_W : NODE_W;
            this.h = NODE_H;
        }
    }

    static class FlowEdge {
        String fromId, toId, label;
        FlowEdge(String f, String t, String l) { fromId = f; toId = t; label = l; }
    }

    // ── 布局 ─────────────────────────────────────────────
    static String generateDrawio(FlowGraph g) {
        Map<String, Integer> ranks = computeRanks(g);
        Map<Integer, List<String>> rankNodes = new TreeMap<>();
        for (String nid : ranks.keySet()) {
            rankNodes.computeIfAbsent(ranks.get(nid), k -> new ArrayList<>()).add(nid);
        }

        Map<String, Double> nodeXs = new HashMap<>();
        Map<String, Double> nodeYs = new HashMap<>();

        // First pass: assign positions (center-based)
        int maxRank = 0;
        for (Map.Entry<Integer, List<String>> entry : rankNodes.entrySet()) {
            int rank = entry.getKey();
            List<String> nids = entry.getValue();
            maxRank = Math.max(maxRank, rank);
            double xOff = PAD;
            for (String nid : nids) {
                FlowNode fn = findNode(g, nid);
                if (fn == null) continue;
                nodeXs.put(nid, xOff);
                nodeYs.put(nid, (double) (PAD + rank * (NODE_H + V_GAP)));
                xOff += fn.w + BRANCH_GAP;
            }
        }

        // Second pass: center nodes at each rank
        double pageW = PAD;
        for (Map.Entry<Integer, List<String>> entry : rankNodes.entrySet()) {
            List<String> nids = entry.getValue();
            double totalW = 0;
            for (String nid : nids) {
                FlowNode fn = findNode(g, nid);
                if (fn != null) totalW += fn.w + BRANCH_GAP;
            }
            if (!nids.isEmpty()) totalW -= BRANCH_GAP;
            // Find max rank width
            pageW = Math.max(pageW, totalW + PAD * 2);
        }

        // Center each rank
        for (Map.Entry<Integer, List<String>> entry : rankNodes.entrySet()) {
            List<String> nids = entry.getValue();
            double totalW = 0;
            for (String nid : nids) {
                FlowNode fn = findNode(g, nid);
                if (fn != null) totalW += fn.w + BRANCH_GAP;
            }
            if (!nids.isEmpty()) totalW -= BRANCH_GAP;
            double startX = (pageW - totalW) / 2;
            for (String nid : nids) {
                FlowNode fn = findNode(g, nid);
                if (fn == null) continue;
                nodeXs.put(nid, startX);
                startX += fn.w + BRANCH_GAP;
            }
        }

        double totalH = PAD + (maxRank + 2) * (NODE_H + V_GAP);

        // Generate XML
        StringBuilder sb = new StringBuilder();
        int cid = 2;
        Map<String, String> idMap = new HashMap<>();

        sb.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n");
        sb.append("<mxfile host=\"Flowchart\" modified=\"2026\" agent=\"plsql-flow\" type=\"device\">\n");
        sb.append("  <diagram name=\"PL/SQL Flowchart\" id=\"d1\">\n");
        sb.append("    <mxGraphModel pageWidth=\"").append(fmt(pageW)).append("\"")
          .append(" pageHeight=\"").append(fmt(totalH)).append("\"")
          .append(" background=\"").append(C_BG).append("\"")
          .append(" grid=\"1\" gridSize=\"10\">\n");
        sb.append("      <root>\n");
        sb.append("        <mxCell id=\"0\"/>\n");
        sb.append("        <mxCell id=\"1\" parent=\"0\"/>\n");

        for (FlowNode fn : g.nodes) {
            Double x = nodeXs.get(fn.id);
            Double y = nodeYs.get(fn.id);
            if (x == null || y == null) continue;
            if (fn.type == NodeType.MERGE) { fn.w = 10; fn.h = 10; }
            String vid = String.valueOf(cid++);
            idMap.put(fn.id, vid);
            String fc, sh = "rounded=1", ext = "";
            switch (fn.type) {
                case START:    fc = C_START; sh = "ellipse"; ext = ";fontStyle=4"; break;
                case END:      fc = C_END; sh = "ellipse"; break;
                case DECISION: fc = C_DECISION; sh = "rhombus"; ext = ";fontStyle=4"; break;
                case LOOP_HEAD:
                case LOOP_TAIL: fc = C_LOOP; ext = ";fontStyle=4"; break;
                case EXCEPTION: fc = C_EXCEPTION; ext = ";fontStyle=4"; break;
                case MERGE:    fc = C_MERGE; sh = "ellipse"; fn.w = 10; fn.h = 10; break;
                default:       fc = C_PROCESS; break;
            }
            String st = sh + ";whiteSpace=wrap;html=1;fontSize=" + FONT_SZ
                + ";fontColor=" + C_TEXT + ";fillColor=" + fc
                + ";strokeColor=none;overflow=hidden" + ext;
            if (fn.type == NodeType.MERGE) st += ";strokeColor=" + C_MERGE + ";strokeWidth=1;";
            sb.append("        <mxCell id=\"").append(vid).append("\"")
              .append(" value=\"").append(xmlEsc(fn.label)).append("\"")
              .append(" vertex=\"1\" parent=\"1\"")
              .append(" style=\"").append(st).append("\">\n");
            sb.append("          <mxGeometry")
              .append(" x=\"").append(fmt(x)).append("\"")
              .append(" y=\"").append(fmt(y)).append("\"")
              .append(" width=\"").append(fmt(fn.w)).append("\"")
              .append(" height=\"").append(fmt(fn.h)).append("\"")
              .append(" as=\"geometry\"/>\n");
            sb.append("        </mxCell>\n");
        }

        String ebs = "edgeStyle=orthogonalEdgeStyle;strokeColor=" + C_EDGE
            + ";strokeWidth=1;rounded=1;fontSize=9;verticalAlign=middle;";

        for (FlowEdge fe : g.edges) {
            String src = idMap.get(fe.fromId);
            String tgt = idMap.get(fe.toId);
            if (src == null || tgt == null) continue;
            String eid = String.valueOf(cid++);
            sb.append("        <mxCell id=\"").append(eid).append("\"")
              .append(" edge=\"1\" parent=\"1\"")
              .append(" source=\"").append(src).append("\"")
              .append(" target=\"").append(tgt).append("\"");
            if (!fe.label.isEmpty()) {
                sb.append(" style=\"").append(ebs).append("labelBackgroundColor=#ffffff;\">\n");
                sb.append("          <mxGeometry relative=\"1\" as=\"geometry\"/>\n");
                sb.append("        </mxCell>\n");
                String lid = String.valueOf(cid++);
                sb.append("        <mxCell id=\"").append(lid).append("\"")
                  .append(" value=\"").append(xmlEsc(fe.label)).append("\"")
                  .append(" vertex=\"1\" parent=\"1\"")
                  .append(" style=\"edgeLabel;html=1;fontSize=9;labelBackgroundColor=#ffffff;\"")
                  .append(" connectable=\"0\">\n");
                sb.append("          <mxGeometry x=\"-0.5\" y=\"0\" relative=\"1\" as=\"geometry\">\n");
                sb.append("            <mxPoint as=\"offset\"/>\n");
                sb.append("          </mxGeometry>\n");
                sb.append("        </mxCell>\n");
            } else {
                sb.append(" style=\"").append(ebs).append("\"/>\n");
            }
        }

        sb.append("      </root>\n");
        sb.append("    </mxGraphModel>\n");
        sb.append("  </diagram>\n");
        sb.append("</mxfile>\n");
        return sb.toString();
    }

    static Map<String, Integer> computeRanks(FlowGraph g) {
        Map<String, Integer> ranks = new HashMap<>();
        if (g.entryId == null) return ranks;
        Queue<String> q = new LinkedList<>();
        q.add(g.entryId);
        ranks.put(g.entryId, 0);
        while (!q.isEmpty()) {
            String cur = q.poll();
            int cr = ranks.get(cur);
            for (FlowEdge e : g.edges) {
                if (e.fromId.equals(cur)) {
                    int nr = cr + 1;
                    if (!ranks.containsKey(e.toId) || ranks.get(e.toId) > nr) {
                        ranks.put(e.toId, nr);
                        q.add(e.toId);
                    }
                }
            }
        }
        return ranks;
    }

    static FlowNode findNode(FlowGraph g, String id) {
        for (FlowNode n : g.nodes) if (n.id.equals(id)) return n;
        return null;
    }

    // ═══════════════════════════════════════════════════════
    //  辅助方法
    // ═══════════════════════════════════════════════════════

    static String cleanText(String s) {
        if (s == null) return "";
        s = s.trim().replaceAll("\\s+", " ");
        s = s.replaceAll("([a-zA-Z0-9_#])([^a-zA-Z0-9_#\\s'\"])", "$1 $2");
        s = s.replaceAll("([^a-zA-Z0-9_#\\s'\"])([a-zA-Z0-9_#])", "$1 $2");
        s = s.replaceAll("\\s+", " ").trim();
        if (s.startsWith(";") || s.startsWith(",")) s = s.substring(1).trim();
        return s.length() > 42 ? s.substring(0, 40) + "..." : s;
    }

    static String getOriginalText(ParseTree node) {
        if (node instanceof ParserRuleContext) {
            ParserRuleContext ctx = (ParserRuleContext) node;
            if (ctx.start != null && ctx.stop != null) {
                int st = ctx.start.getStartIndex();
                int en = ctx.stop.getStopIndex();
                if (st >= 0 && en < currentSource.length()) return currentSource.substring(st, en + 1);
            }
        }
        return node.getText();
    }

    static String extractRuleText(ParseTree node, String ruleName) {
        ParseTree child = findChildByRule(node, ruleName, 0);
        if (child == null) return "";
        return cleanText(getOriginalText(child));
    }

    // ── ANTLR 树遍历辅助 ────────────────────────────────
    static ParseTree findChildByRule(ParseTree node, String ruleName, int occurrence) {
        if (node == null) return null;
        int found = 0;
        Stack<ParseTree> stack = new Stack<>();
        stack.push(node);
        while (!stack.isEmpty()) {
            ParseTree cur = stack.pop();
            for (int i = 0; i < cur.getChildCount(); i++) {
                ParseTree c = cur.getChild(i);
                if (!(c instanceof RuleContext)) continue;
                int ri = ((RuleContext) c).getRuleIndex();
                if (ri >= 0 && ri < PlSqlParser.ruleNames.length) {
                    if (PlSqlParser.ruleNames[ri].equals(ruleName)) {
                        if (found == occurrence) return c;
                        found++;
                    }
                } else { stack.push(c); }
            }
        }
        return null;
    }

    static List<ParseTree> findAllChildrenByRule(ParseTree node, String ruleName) {
        List<ParseTree> result = new ArrayList<>();
        if (node == null) return result;
        Stack<ParseTree> stack = new Stack<>();
        stack.push(node);
        while (!stack.isEmpty()) {
            ParseTree cur = stack.pop();
            for (int i = 0; i < cur.getChildCount(); i++) {
                ParseTree c = cur.getChild(i);
                if (!(c instanceof RuleContext)) continue;
                int ri = ((RuleContext) c).getRuleIndex();
                if (ri >= 0 && ri < PlSqlParser.ruleNames.length) {
                    if (PlSqlParser.ruleNames[ri].equals(ruleName)) result.add(c);
                } else { stack.push(c); }
            }
        }
        return result;
    }

    static List<ParseTree> extractStatementsFromSeq(ParseTree seqNode) {
        List<ParseTree> result = new ArrayList<>();
        if (seqNode == null) return result;
        Stack<ParseTree> stack = new Stack<>();
        stack.push(seqNode);
        while (!stack.isEmpty()) {
            ParseTree cur = stack.pop();
            for (int i = 0; i < cur.getChildCount(); i++) {
                ParseTree c = cur.getChild(i);
                if (!(c instanceof RuleContext)) continue;
                int ri = ((RuleContext) c).getRuleIndex();
                if (ri >= 0 && ri < PlSqlParser.ruleNames.length) {
                    if (PlSqlParser.ruleNames[ri].equals("statement")) result.add(c);
                } else { stack.push(c); }
            }
        }
        return result;
    }

    static ParseTree findFirstExecutableUnit(ParseTree root) {
        if (root == null) return null;
        Stack<ParseTree> stack = new Stack<>();
        stack.push(root);
        while (!stack.isEmpty()) {
            ParseTree cur = stack.pop();
            for (int i = 0; i < cur.getChildCount(); i++) {
                ParseTree c = cur.getChild(i);
                if (!(c instanceof RuleContext)) continue;
                int ri = ((RuleContext) c).getRuleIndex();
                if (ri >= 0 && ri < PlSqlParser.ruleNames.length) {
                    String rn = PlSqlParser.ruleNames[ri];
                    if (rn.equals("create_procedure_body") || rn.equals("create_function_body")
                        || rn.equals("anonymous_block") || rn.equals("create_package_body"))
                        return c;
                    if (rn.equals("unit_statement")) stack.push(c);
                } else { stack.push(c); }
            }
        }
        return null;
    }

    static String extractEntryName(ParseTree node) {
        if (node == null) return "PROGRAM";
        int ri = ((RuleContext) node).getRuleIndex();
        if (ri < 0 || ri >= PlSqlParser.ruleNames.length) return "PROGRAM";
        String rn = PlSqlParser.ruleNames[ri];
        boolean isFunc = rn.contains("function");
        for (int i = 0; i < node.getChildCount(); i++) {
            ParseTree c = node.getChild(i);
            if (c instanceof TerminalNode) {
                String t = c.getText().toUpperCase();
                if (t.equals("PROCEDURE") || t.equals("FUNCTION")) {
                    if (i + 1 < node.getChildCount()) {
                        ParseTree next = node.getChild(i + 1);
                        String nm = next instanceof RuleContext
                            ? next.getText().trim().split("\\s")[0]
                            : next.getText();
                        if (nm.matches("[a-zA-Z_#][a-zA-Z0-9_#$]*"))
                            return isFunc ? nm : nm;
                    }
                }
            }
        }
        return rn.contains("package") ? "Package Init" : rn.contains("anonymous") ? "Block" : "Unit";
    }

    static List<ParseTree> extractBodyStatements(ParseTree node) {
        if (node == null) return null;
        // Find body → seq_of_statements
        ParseTree bodyNode = findChildByRule(node, "body", 0);
        if (bodyNode != null) {
            ParseTree seq = findChildByRule(bodyNode, "seq_of_statements", 0);
            if (seq != null) return extractStatementsFromSeq(seq);
        }
        // Package body init block
        ParseTree initSeq = findChildByRule(node, "seq_of_statements", 0);
        if (initSeq != null) return extractStatementsFromSeq(initSeq);
        return null;
    }

    static String extractLoopLabel(ParseTree node) {
        for (int i = 0; i < node.getChildCount(); i++) {
            ParseTree c = node.getChild(i);
            if (c instanceof TerminalNode) {
                String t = c.getText().toUpperCase();
                if (t.equals("WHILE")) {
                    String cond = extractRuleText(node, "condition");
                    return "WHILE " + (cond.isEmpty() ? "..." : cond);
                } else if (t.equals("FOR")) {
                    String p = extractRuleText(node, "cursor_loop_param");
                    return "FOR " + (p.isEmpty() ? "..." : cleanText(p).length() > 25 ? cleanText(p).substring(0, 23) + "..." : cleanText(p));
                }
            }
        }
        return "LOOP";
    }

    static String fmt(double d) {
        return d == (int) d ? String.valueOf((int) d) : String.format("%.1f", d);
    }

    static String xmlEsc(String s) {
        if (s == null) return "";
        return s.replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace("\"", "&quot;")
                .replace("'", "&apos;");
    }

    static String generateEmptyFallback() {
        return "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
             + "<mxfile host=\"Flowchart\" modified=\"2026\" agent=\"plsql\" type=\"device\">\n"
             + "  <diagram name=\"Flowchart\" id=\"d1\">\n"
             + "    <mxGraphModel pageWidth=\"400\" pageHeight=\"300\" background=\"#f8f9fa\">\n"
             + "      <root>\n"
             + "        <mxCell id=\"0\"/>\n"
             + "        <mxCell id=\"1\" parent=\"0\"/>\n"
             + "        <mxCell id=\"2\" value=\"No flow found\" vertex=\"1\" parent=\"1\""
             + " style=\"rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#ffffff;fillColor=#909399;\">\n"
             + "          <mxGeometry x=\"100\" y=\"100\" width=\"200\" height=\"36\" as=\"geometry\"/>\n"
             + "        </mxCell>\n"
             + "      </root>\n"
             + "    </mxGraphModel>\n"
             + "  </diagram>\n"
             + "</mxfile>\n";
    }

    // ── CaseInsensitiveStream ────────────────────────────
    static class CaseInsensitiveStream implements CharStream {
        private final CharStream stream;
        CaseInsensitiveStream(CharStream s) { this.stream = s; }
        public void consume() { stream.consume(); }
        public int LA(int i) { int c = stream.LA(i); return c >= 'a' && c <= 'z' ? c - 32 : c >= 224 && c <= 255 ? c - 32 : c; }
        public int mark() { return stream.mark(); }
        public void release(int marker) { stream.release(marker); }
        public int index() { return stream.index(); }
        public void seek(int index) { stream.seek(index); }
        public int size() { return stream.size(); }
        public String getSourceName() { return stream.getSourceName(); }
        public String getText(Interval interval) { return stream.getText(interval); }
    }

    // ── main ─────────────────────────────────────────────
    public static void main(String[] args) throws Exception {
        if (args.length < 1) { System.err.println("Usage: ... <input.sql> [output.drawio]"); System.exit(1); }
        String src;
        if ("-".equals(args[0])) {
            BufferedReader r = new BufferedReader(new InputStreamReader(System.in));
            StringBuilder sb = new StringBuilder();
            String line; while ((line = r.readLine()) != null) sb.append(line).append("\n");
            src = sb.toString();
        } else {
            src = new String(Files.readAllBytes(Paths.get(args[0])));
        }
        String outPath = args.length >= 2 ? args[1] : args[0].replace(".sql", ".flow.drawio");
        String xml = plsqlToFlowchart(src);
        Files.write(Paths.get(outPath), xml.getBytes());
        System.out.println("OK: " + outPath);
    }
}
